{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build opencl.cpp",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "\"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cl /EHsc /std:c++17 /I\"%OCL_ROOT%\\include\" opencl.cpp /Fe:opencl.exe /link /LIBPATH:\"%OCL_ROOT%\\lib\\x86_64\" OpenCL.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
